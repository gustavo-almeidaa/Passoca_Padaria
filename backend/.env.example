# Copie este arquivo para .env e ajuste conforme necessário.
# O .env nunca deve ser commitado (já está no .gitignore).

# PostgreSQL gerenciado (Neon) — decisão registrada no CLAUDE.md, seção 11
# (2026-08-25). Pegue a "Connection string" no dashboard do seu projeto Neon
# e cole aqui, trocando o prefixo "postgresql://" por "postgresql+psycopg://"
# (é o driver psycopg3 que o SQLAlchemy usa neste projeto). Mantenha o
# "?sslmode=require" no final — o Neon exige conexão criptografada.
DATABASE_URL=postgresql+psycopg://usuario:senha@ep-exemplo.regiao.aws.neon.tech/passoca_padaria?sslmode=require

# SQLite — alternativa só para desenvolvimento local rápido, sem depender de
# internet (ex.: testando algo offline). Não é mais o banco "oficial" do
# projeto; produção e o fluxo padrão de desenvolvimento usam Neon acima.
# DATABASE_URL=sqlite:///./app.db

# Autenticação (Incremento 12). Gere uma chave própria por ambiente — nunca
# reaproveite esta nem a de outro .env:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=troque-por-uma-chave-gerada-so-sua

# "development" (default) ou "production" — setar production no Render.
# Com production, o servidor recusa subir se SESSION_SECRET_KEY ainda for
# o valor de dev.
ENVIRONMENT=development

# Usuário inicial (proprietária) — criado automaticamente no primeiro boot,
# só se o banco ainda não tiver nenhum usuário cadastrado.
ADMIN_NOME=Proprietária
ADMIN_EMAIL=dona@passoca.com
ADMIN_SENHA=troque-esta-senha-antes-de-usar-de-verdade
