# Copie este arquivo para .env e ajuste conforme necessário.
# O .env nunca deve ser commitado (já está no .gitignore).

# SQLite para desenvolvimento local (decisão registrada no CLAUDE.md, seção 11).
DATABASE_URL=sqlite:///./app.db

# Exemplo de como ficaria com PostgreSQL, para quando a migração manual
# acontecer (não usar agora):
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/passoca_padaria
