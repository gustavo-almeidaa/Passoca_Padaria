diff --git a/frontend/js/relatorio.js b/frontend/js/relatorio.js
new file mode 100644
index 0000000..ca01321
--- /dev/null
+++ b/frontend/js/relatorio.js
@@ -0,0 +1,79 @@
+/*
+ * Tela de Relatório — Projeto Final de Engenharia de Software.
+ *
+ * Ranking de produtos mais encomendados + faturamento por período, a partir
+ * de GET /relatorios/produtos-mais-encomendados (só proprietária — o
+ * auth.js remove a aba dos outros perfis e o backend responde 403).
+ */
+document.addEventListener("DOMContentLoaded", () => {
+  const form = document.getElementById("form-relatorio");
+  if (!form) return; // perfil sem acesso: seção removida pelo auth.js
+
+  const inputInicio = document.getElementById("r-data-inicio");
+  const inputFim = document.getElementById("r-data-fim");
+  const botao = document.getElementById("botao-gerar-relatorio");
+  const feedback = document.getElementById("feedback-relatorio");
+  const resumo = document.getElementById("resumo-relatorio");
+  const lista = document.getElementById("lista-relatorio");
+
+  document.addEventListener("tela:ativada", (evento) => {
+    if (evento.detail.tela === "relatorio") gerar();
+  });
+
+  form.addEventListener("submit", (evento) => {
+    evento.preventDefault();
+    gerar();
+  });
+
+  async function gerar() {
+    limparFeedback(feedback);
+    if (inputInicio.value && inputFim.value && inputInicio.value > inputFim.value) {
+      mostrarFeedback(feedback, "A data inicial não pode ser depois da final.", "erro");
+      return;
+    }
+    definirCarregando(botao, true, "Gerando...");
+    lista.innerHTML = '<p class="empty">Carregando…</p>';
+    try {
+      const dados = await api.relatorioProdutos({
+        data_inicio: inputInicio.value || undefined,
+        data_fim: inputFim.value || undefined,
+      });
+      render(dados);
+    } catch (erro) {
+      resumo.innerHTML = "";
+      lista.innerHTML = "";
+      mostrarFeedback(feedback, erro.message, "erro");
+    } finally {
+      definirCarregando(botao, false);
+    }
+  }
+
+  function render(dados) {
+    if (dados.produtos.length === 0) {
+      resumo.innerHTML = "";
+      lista.innerHTML = '<p class="empty">Nenhum pedido nesse período.</p>';
+      return;
+    }
+    resumo.innerHTML =
+      `<b>${dados.total_pedidos}</b> ${dados.total_pedidos === 1 ? "pedido" : "pedidos"} · ` +
+      `faturamento total <b>${moeda(dados.faturamento_total)}</b>`;
+    lista.innerHTML = dados.produtos.map(montarLinha).join("");
+  }
+
+  function montarLinha(p, indice) {
+    return `
+      <div class="produto-item">
+        <div class="produto-item__principal">
+          <b>${indice + 1}. ${escapeHtml(p.nome)}</b>
+          <span class="produto-item__preco">${moeda(p.faturamento)}</span>
+        </div>
+        <div class="produto-item__meta">
+          ${escapeHtml(p.categoria)} · ${p.quantidade_total} un. · em ${p.pedidos} ${p.pedidos === 1 ? "pedido" : "pedidos"}
+        </div>
+      </div>`;
+  }
+
+  function moeda(valor) {
+    return Number(valor).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
+  }
+});
