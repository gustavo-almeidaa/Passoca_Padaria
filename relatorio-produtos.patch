+"""Testes do relatório de produtos mais encomendados (Projeto Final).
+
+Cobre: ranking por faturamento, exclusão de cancelados, filtro por período,
+período inválido, relatório vazio e acesso restrito à proprietária.
+"""
+from datetime import datetime, timedelta
+
+from app.api.deps import get_usuario_atual
+from app.core.security import hash_senha
+from app.main import app
+from app.models.usuario import PerfilUsuario, Usuario
+
+
+def _entrega(dias=3):
+    m = datetime.now() + timedelta(days=dias)
+    return m.date().isoformat(), m.time().replace(microsecond=0).isoformat()
+
+
+def _cliente(client):
+    return client.post(
+        "/clientes", json={"nome": "Maria", "telefone": "43999990000"}
+    ).json()["id"]
+
+
+def _produto(client, nome, preco):
+    return client.post(
+        "/produtos",
+        json={
+            "nome": nome,
+            "categoria": "pao",
+            "unidade": "unidade",
+            "preco": preco,
+            "personalizavel": False,
+        },
+    ).json()["id"]
+
+
+def _pedido(client, cid, itens, dias=3):
+    data, hora = _entrega(dias)
+    r = client.post(
+        "/pedidos",
+        json={
+            "cliente_id": cid,
+            "data_entrega": data,
+            "hora_entrega": hora,
+            "itens": [{"produto_id": p, "quantidade": q} for p, q in itens],
+        },
+    )
+    assert r.status_code == 201, r.text
+    return r.json()["id"]
+
+
+def test_ranking_ordenado_por_faturamento(client):
+    cid = _cliente(client)
+    pao = _produto(client, "Pão", "2.00")
+    bolo = _produto(client, "Bolo", "40.00")
+    _pedido(client, cid, [(pao, 10), (bolo, 1)])  # pão 20, bolo 40
+    _pedido(client, cid, [(pao, 5)])  # pão +10
+
+    corpo = client.get("/relatorios/produtos-mais-encomendados").json()
+
+    assert [p["nome"] for p in corpo["produtos"]] == ["Bolo", "Pão"]
+    assert corpo["produtos"][0]["faturamento"] == "40.00"
+    assert corpo["produtos"][1]["quantidade_total"] == 15
+    assert corpo["produtos"][1]["pedidos"] == 2
+    assert corpo["faturamento_total"] == "70.00"
+    assert corpo["total_pedidos"] == 2
+
+
+def test_pedido_cancelado_fica_de_fora(client):
+    cid = _cliente(client)
+    pao = _produto(client, "Pão", "2.00")
+    _pedido(client, cid, [(pao, 10)])
+    cancelado = _pedido(client, cid, [(pao, 100)], dias=5)
+    assert client.post(f"/pedidos/{cancelado}/cancelar").status_code == 200
+
+    corpo = client.get("/relatorios/produtos-mais-encomendados").json()
+
+    assert corpo["produtos"][0]["quantidade_total"] == 10
+    assert corpo["faturamento_total"] == "20.00"
+    assert corpo["total_pedidos"] == 1
+
+
+def test_filtro_por_periodo(client):
+    cid = _cliente(client)
+    pao = _produto(client, "Pão", "2.00")
+    _pedido(client, cid, [(pao, 10)], dias=3)
+    _pedido(client, cid, [(pao, 50)], dias=20)
+    corte = (datetime.now() + timedelta(days=10)).date().isoformat()
+
+    antes = client.get(
+        "/relatorios/produtos-mais-encomendados", params={"data_fim": corte}
+    ).json()
+    depois = client.get(
+        "/relatorios/produtos-mais-encomendados", params={"data_inicio": corte}
+    ).json()
+
+    assert antes["produtos"][0]["quantidade_total"] == 10
+    assert depois["produtos"][0]["quantidade_total"] == 50
+
+
+def test_periodo_invertido_retorna_422(client):
+    r = client.get(
+        "/relatorios/produtos-mais-encomendados",
+        params={"data_inicio": "2026-12-31", "data_fim": "2026-01-01"},
+    )
+    assert r.status_code == 422
+
+
+def test_relatorio_vazio(client):
+    corpo = client.get("/relatorios/produtos-mais-encomendados").json()
+    assert corpo["produtos"] == []
+    assert corpo["faturamento_total"] == "0"
+    assert corpo["total_pedidos"] == 0
+
+
+def test_so_proprietaria_acessa(client, db_session):
+    atendente = Usuario(
+        nome="Atendente",
+        email="atendente@passoca.com",
+        senha_hash=hash_senha("senha-de-teste-123"),
+        perfil=PerfilUsuario.ATENDENTE,
+    )
+    db_session.add(atendente)
+    db_session.commit()
+    app.dependency_overrides[get_usuario_atual] = lambda: atendente
+
+    r = client.get("/relatorios/produtos-mais-encomendados")
+
+    assert r.status_code == 403
