+"""Relatório avançado — produtos mais encomendados e faturamento por período.
+
+Projeto Final de Engenharia de Software. Só a proprietária consulta (dado
+financeiro, mesma decisão da aba Auditoria). Pedidos cancelados ficam de
+fora, a mesma regra do resumo do histórico por cliente (Incremento 24).
+O período filtra pela data de ENTREGA do pedido, igual à listagem de
+pedidos (RF07).
+"""
+from __future__ import annotations
+
+from datetime import date
+from decimal import Decimal
+from typing import Optional
+
+from fastapi import APIRouter, Depends, HTTPException, Query, status
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from app.api.deps import exigir_proprietaria
+from app.core.database import get_db
+from app.models.item_pedido import ItemPedido
+from app.models.pedido import Pedido, StatusPedido
+from app.models.produto import Produto
+from app.schemas.relatorio import ProdutoRankingItem, RelatorioProdutosRead
+
+router = APIRouter(
+    prefix="/relatorios",
+    tags=["relatorios"],
+    dependencies=[Depends(exigir_proprietaria)],
+)
+
+LIMITE_PADRAO = 20
+LIMITE_MAXIMO = 100
+
+
+@router.get("/produtos-mais-encomendados", response_model=RelatorioProdutosRead)
+def produtos_mais_encomendados(
+    db: Session = Depends(get_db),
+    data_inicio: Optional[date] = Query(
+        default=None, description="Entregas a partir desta data (inclusive)."
+    ),
+    data_fim: Optional[date] = Query(
+        default=None, description="Entregas até esta data (inclusive)."
+    ),
+    limite: int = Query(default=LIMITE_PADRAO, ge=1, le=LIMITE_MAXIMO),
+) -> RelatorioProdutosRead:
+    if data_inicio and data_fim and data_inicio > data_fim:
+        raise HTTPException(
+            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
+            detail="A data inicial não pode ser depois da data final.",
+        )
+
+    filtros = [Pedido.status != StatusPedido.CANCELADO]
+    if data_inicio is not None:
+        filtros.append(Pedido.data_entrega >= data_inicio)
+    if data_fim is not None:
+        filtros.append(Pedido.data_entrega <= data_fim)
+
+    valor_item = ItemPedido.quantidade * ItemPedido.preco_unitario
+    linhas = (
+        db.query(
+            Produto.id,
+            Produto.nome,
+            Produto.categoria,
+            func.sum(ItemPedido.quantidade).label("quantidade_total"),
+            func.count(func.distinct(ItemPedido.pedido_id)).label("pedidos"),
+            func.sum(valor_item).label("faturamento"),
+        )
+        .join(ItemPedido, ItemPedido.produto_id == Produto.id)
+        .join(Pedido, Pedido.id == ItemPedido.pedido_id)
+        .filter(*filtros)
+        .group_by(Produto.id, Produto.nome, Produto.categoria)
+        .order_by(func.sum(valor_item).desc(), Produto.nome)
+        .limit(limite)
+        .all()
+    )
+
+    # Totais do período inteiro (não só do top N).
+    total_pedidos, faturamento_total = (
+        db.query(
+            func.count(func.distinct(Pedido.id)),
+            func.coalesce(func.sum(valor_item), 0),
+        )
+        .select_from(Pedido)
+        .join(ItemPedido, ItemPedido.pedido_id == Pedido.id)
+        .filter(*filtros)
+        .one()
+    )
+
+    return RelatorioProdutosRead(
+        data_inicio=data_inicio,
+        data_fim=data_fim,
+        total_pedidos=total_pedidos or 0,
+        faturamento_total=Decimal(faturamento_total or 0),
+        produtos=[
+            ProdutoRankingItem(
+                produto_id=linha.id,
+                nome=linha.nome,
+                categoria=linha.categoria.value,
+                quantidade_total=int(linha.quantidade_total),
+                pedidos=int(linha.pedidos),
+                faturamento=Decimal(linha.faturamento),
+            )
+            for linha in linhas
+        ],
+    )
